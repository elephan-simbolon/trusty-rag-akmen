SILICONFLOW_API_KEY=sk-your-key-here
QDRANT_URL=https://your-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-api-key
PYTORCH_CUDA_ALLOC_CONF=max_split_size_mb:512,expandable_segments:True
LANGFUSE_PUBLIC_KEY=pk-lf-your-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-here
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# DeepSeek API — untuk LightRAG entity extraction (no hard rate limit)
# Daftar di https://platform.deepseek.com
DEEPSEEK_API_KEY=your-deepseek-api-key-here

# Model ekstraksi LightRAG (default: deepseek-chat = DeepSeek-V3.2)
# Fallback ke SiliconFlow jika DEEPSEEK_API_KEY kosong
LIGHTRAG_LLM_MODEL=deepseek-chat
